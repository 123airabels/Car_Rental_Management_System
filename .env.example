DB_HOST=localhost
DB_PORT=5432
DB_NAME=car_rental_db
DB_USERNAME=postgres
DB_PASSWORD=replace_with_your_local_password
# Confirmation emails, option 1 (recommended): your own Gmail with an App Password
# (Google Account > Security > turn on 2-Step Verification > App passwords). Use the 16-letter app password, not your normal password.
MAIL_USERNAME=yourname@gmail.com
MAIL_PASSWORD=your_16_letter_app_password
# Option 2: the free Brevo API (brevo.com). Only used if MAIL_USERNAME / MAIL_PASSWORD are empty.
BREVO_API_KEY=your_brevo_api_key
# The sender email you verified in Brevo
MAIL_FROM=you@example.com
# At least 32 random characters
JWT_SECRET=replace_with_a_long_random_value
# Where verify.html is served (change if you do not use Live Server on the project root)
FRONTEND_URL=http://127.0.0.1:5500/Frontend
# Leave as localhost to auto-use this computer's network address in emails (works on the same Wi-Fi/LAN).
# For opening the link from ANY network, set a public URL here (e.g. https://abc123.ngrok-free.app) and the same origin in CORS_ORIGINS.
# CORS_ORIGINS=https://abc123.ngrok-free.app
# ANY NETWORK (mobile data etc.): run  ngrok http 8080  then set the https address it prints, with no trailing folder:
# FRONTEND_URL=https://abc123.ngrok-free.app
# CORS_ORIGINS=https://abc123.ngrok-free.app
